# ───────── 7ots · configuración del proxy (copia a .env y rellena) ─────────
# Las claves SOLO viven aquí, en el servidor. Nunca en el HTML del sitio.

PORT=8787
# Orígenes que pueden usar el proxy (coma). El propio origen siempre está permitido.
ALLOWED_ORIGINS=http://localhost:8787
# Identificadores públicos de sitio aceptados (X-Site-Key). Vacío = no se exige.
SITE_KEYS=
RATE_LIMIT_PER_MIN=40
# TRUST_PROXY=true          # si hay un proxy inverso delante (usa X-Forwarded-For)
# SERVER_INSTRUCTIONS=      # texto que se antepone siempre al system prompt

# ───────── LLM ─────────
# anthropic | openai | mock (sin claves, para desarrollo)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Por defecto: claude-opus-5-5 (anthropic) · gpt-4.1-mini (openai)
LLM_MODEL=
# Para proveedores compatibles con OpenAI (DeepSeek, Groq, Ollama, OpenRouter…)
LLM_BASE_URL=
# Claude: low | medium | high | xhigh | max  (low = respuestas rápidas en el chat)
LLM_EFFORT=low
LLM_MAX_TOKENS=8000
# Reintento server-side en otro modelo si Claude rechaza una petición. "off" en Bedrock/Vertex/Foundry.
LLM_FALLBACKS=on

# ───────── Voz (TTS) ─────────
# 7ots no aloja audio: usa tu propia cuenta de cada proveedor.
# apuchat | elevenlabs | grok | fish | openai | none (none = voz del navegador)
# Vacío = el primero con clave, en ese orden.
TTS_PROVIDER=none
# Audio de apuchat (voice.apuchat.com, POST /speak). El token va en la cabecera X-Voice-Test-Token.
APUCHAT_VOICE_URL=https://voice.apuchat.com
APUCHAT_VOICE_TOKEN=
# Voz: narrator, es_narrador, es_locutor (fish), adam, rachel (ElevenLabs), eve, ara (xAI)… o un id crudo
APUCHAT_VOICE_ID=
# Motor dentro de apuchat: fish | elevenlabs | xai (vacío = lo elige el servidor, con respaldo)
APUCHAT_VOICE_PROVIDER=
# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# xAI (Grok) TTS: POST https://api.x.ai/v1/tts. Voces: eve, ara, leo, rex, sal (o un id de voz propia)
XAI_API_KEY=
XAI_TTS_VOICE=
# Fish Audio: POST https://api.fish.audio/v1/tts. FISH_VOICE_ID = reference_id del modelo de voz
# (vacío = voz propia del modelo). FISH_MODEL: s2.1-pro (por defecto), s2.1-pro-free, s2-pro, s1
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=
# OpenAI (compatibilidad): usa OPENAI_API_KEY
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ───────── Apumail (correo / tickets) ─────────
# Se envía desde un buzón tuyo de apumail.com (POST /api/v1/inbox/<buzón>/send).
# Usa un buzón permanente o de dominio propio: los gratis caducan a las 24 h y envían 5/día.
APUMAIL_API=https://api.apumail.com
APUMAIL_INBOX=
# Token del buzón (se muestra una vez al crearlo) o PAT acct_… de la cuenta dueña
APUMAIL_INBOX_TOKEN=
# Buzón del equipo que recibe los tickets
APUMAIL_TO=

# ───────── Apuchat (derivar a una persona) ─────────
APUCHAT_HUB=https://apuchat.com
# Identidad (x-identity-key) que envía el aviso por DM y handle del operador que lo recibe (sin @)
# El proxy hace de relé con el canal: el hub no admite CORS de otros sitios.
APUCHAT_NOTIFIER_IDENTITY_KEY=
APUCHAT_OPERATOR_HANDLE=
APUCHAT_TRANSCRIBE=false

# ───────── Backoffice (/backoffice/) ─────────
# Sin contraseña, el backoffice solo abre desde la propia máquina (localhost).
# Con ADMIN_PASSWORD se puede entrar desde fuera (cookie firmada, 12 h). Usa una larga.
ADMIN_PASSWORD=
# Dónde guarda el backoffice la configuración del widget y del servidor, y las claves (0600).
# Defecto: data/config.json y data/secrets.json. Lo guardado allí manda sobre este .env.
CONFIG_FILE=
SECRETS_FILE=

# ───────── Identidad del agente ─────────
# Ficha de identidad (nombre, aspecto, voz, contacto). La escribe el backoffice. Defecto: data/identity.json
IDENTITY_FILE=

# ───────── El agente por apumail / apuchat / meet (opcional) ─────────
# Persona del agente fuera de la web
AGENT_NAME=
AGENT_ROLE=
AGENT_SITE_URL=
AGENT_INSTRUCTIONS=
AGENT_LANG=es
# Buzón propio del agente: contesta los correos que recibe
APUMAIL_AGENT_INBOX=
APUMAIL_AGENT_TOKEN=
# Con secreto: webhook en POST /api/agent/channels/apumail (URL pública). Sin él: long-poll.
APUMAIL_AGENT_WEBHOOK_SECRET=
APUMAIL_AGENT_DAILY=20
# Identidad propia del agente en apuchat: contesta mensajes, entra en llamadas de meet y llama a la app
APUCHAT_AGENT_IDENTITY_KEY=
APUCHAT_AGENT_AVATAR=vivi
APUCHAT_AGENT_SCENE=
APUCHAT_AGENT_ALLOW=
AGENT_MAX_CALLS=3
AGENT_CALL_MAX_MINUTES=15
AGENT_CALL_MAX_TURNS=40

# ───────── Demo ─────────
DEMO=true
SERVE_STATIC=true
DEMO_JWT_SECRET=
LOG_LEVEL=info
# Idioma del servidor (es, en, pt): correos y avisos al equipo y consola. Vacío = idioma de la
# identidad del agente; si no, español. A visitantes y backoffice se les responde según Accept-Language.
LOCALE=

# ───────── Plataforma 7ots.com (cuentas y varios ots) ─────────
# Con PLATFORM=true el mismo servidor sirve el dashboard /app/ (entrar, crear y gestionar ots),
# la API pública de cada ots en /api/o/<id>/* y edita cada ots en /backoffice/?ots=<id>.
PLATFORM=false
PLATFORM_URL=https://7ots.com
PLATFORM_DB=./data/platform.db
# Secreto de la plataforma (cifra las claves de cada ots y firma cookies): openssl rand -hex 32
PLATFORM_SECRET=
PLATFORM_MAX_OTS=10
PLATFORM_OTS_RATE_PER_MIN=120
# Llamadas de chat y voz por ots y día (tope de gasto aunque alguien falsifique el Origin)
PLATFORM_OTS_DAILY_LIMIT=1000
# Cuentas nuevas por IP y día (cada una trae cupo gratis)
PLATFORM_NEW_ACCOUNTS_PER_IP_DAY=3
# Llamadas pagadas por la plataforma en curso a la vez por cuenta
PLATFORM_MAX_INFLIGHT=4
# IA y voz de la plataforma para los ots sin clave propia, con cupo gratis por cuenta y mes
# PLATFORM_LLM_PROVIDER: anthropic | openai (y compatibles: DeepSeek, Groq… con PLATFORM_LLM_BASE_URL)
PLATFORM_LLM_PROVIDER=
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_BASE_URL=
PLATFORM_LLM_MODEL=
# Ejemplo DeepSeek: PLATFORM_LLM_PROVIDER=openai PLATFORM_LLM_BASE_URL=https://api.deepseek.com PLATFORM_LLM_MODEL=deepseek-flash
# (compatibilidad: PLATFORM_ANTHROPIC_API_KEY=… equivale a provider anthropic con esa clave)
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_FREE_MESSAGES=100
PLATFORM_APUCHAT_VOICE_TOKEN=
PLATFORM_FREE_TTS=100
# Buzón de apumail que envía los enlaces de acceso (sin él, fuera de producción el enlace sale por consola)
PLATFORM_MAIL_INBOX=
PLATFORM_MAIL_TOKEN=
# Entrar con notlogin (OIDC). Redirect: <PLATFORM_URL>/auth/notlogin/callback
NOTLOGIN_URL=https://notlogin.com
NOTLOGIN_CLIENT_ID=
NOTLOGIN_CLIENT_SECRET=
# Identidades gratis de apuchat por cuenta y día (pestaña apuchat de cada ots; el hub es APUCHAT_HUB)
PLATFORM_APUCHAT_IDENTITIES_PER_DAY=5
# Orquesta: tareas que un ots puede encargar a un agente (OAuth con registro dinámico, sin client id fijo)
ORQUESTA_URL=https://getorquesta.com
